// Prisma Schema for AI-Powered Urban Cadastral Mapping & Land Management System
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}

enum LandType {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  INDUSTRIAL
  UNCLAIMED
  PUBLIC_INFRASTRUCTURE
}

enum ParcelStatus {
  DRAFT_SEGMENTATION
  TOPOLOGY_VERIFIED
  SURVEYOR_ADJUSTED
  TITLE_ISSUED
  ENCROACHMENT_DISPUTE
}

enum AuditAction {
  INITIAL_INGESTION
  TOPOLOGY_REPAIR
  SURVEYOR_ADJUSTMENT
  VLM_CLASSIFICATION
  TITLE_CERTIFICATION
}

model Owner {
  id              String    @id @default(uuid())
  fullName        String
  nationalId      String    @unique
  contactNumber   String?
  email           String?
  residentialAddress String?
  registeredDate  DateTime  @default(now())
  parcels         Parcel[]

  @@map("owners")
}

model Parcel {
  id                      String              @id @default(uuid())
  uprn                    String              @unique // Unique Property Reference Number
  geoTraceCardNumber      String?             @unique
  svamitvaCardNumber      String?             @unique
  ownerId                 String?
  owner                   Owner?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  landType                LandType            @default(RESIDENTIAL)
  status                  ParcelStatus        @default(DRAFT_SEGMENTATION)
  
  // Geospatial geometry & measurements
  boundaryGeoJson         String              // GeoJSON Polygon / MultiPolygon string
  calculatedAreaSqMeters  Float               // Shoelace formula computed geodesic area
  perimeterMeters         Float               // Total boundary perimeter length
  centroidLat             Float
  centroidLng             Float
  
  // Uncertainty-aware GeoAI scores
  epistemicUncertainty    Float               @default(0.0) // Model prediction variance
  aleatoricUncertainty    Float               @default(0.0) // Aerial image shadow/occlusion noise
  overallUncertainty      Float               @default(0.0) // Calibrated combined uncertainty
  
  // VLM AI Land-Use & Encroachment Audit
  structureCount          Int                 @default(0)
  complianceScore         Int                 @default(100) // 0 - 100
  encroachmentDetected    Boolean             @default(false)
  encroachmentRemarks     String?
  lastVlmAuditTimestamp   DateTime?
  
  // Cryptographic immutability & audit chaining
  currentHash             String              // SHA-256 of coordinates + previous block hash
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  
  // Relations
  coordinates             BoundaryCoordinate[]
  auditTrailBlocks        AuditTrailHashBlock[]
  zoningLogs              ZoningLog[]
  encroachmentAlerts      EncroachmentAlert[]
  surveySessionId         String?
  surveySession           SurveySession?      @relation(fields: [surveySessionId], references: [id])

  @@map("parcels")
}

model BoundaryCoordinate {
  id                   String   @id @default(uuid())
  parcelId             String
  parcel               Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  sequenceIndex        Int
  latitude             Float
  longitude            Float
  elevationMeters      Float?   @default(0.0)
  isSurveyorAdjusted   Boolean  @default(false)
  isSharedBoundaryNode Boolean  @default(false)

  @@unique([parcelId, sequenceIndex])
  @@map("boundary_coordinates")
}

model AuditTrailHashBlock {
  id                    String      @id @default(uuid())
  parcelId              String
  parcel                Parcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  blockIndex            Int
  action                AuditAction
  previousHash          String
  currentHash           String      // SHA256(previousHash + coordinates + surveyorId + timestamp)
  coordinatesPayloadSha String      // SHA-256 hash of normalized WGS84 coordinates array
  surveyorId            String
  surveyorName          String
  surveyorDigitalSig    String?
  changeDescription     String
  timestamp             DateTime    @default(now())

  @@unique([parcelId, blockIndex])
  @@map("audit_trail_hash_blocks")
}

model ZoningLog {
  id             String    @id @default(uuid())
  parcelId       String
  parcel         Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  previousZoning LandType
  newZoning      LandType
  justification  String
  surveyorId     String
  timestamp      DateTime  @default(now())

  @@map("zoning_logs")
}

model EncroachmentAlert {
  id                        String   @id @default(uuid())
  parcelId                  String
  parcel                    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  severity                  String   // LOW, MEDIUM, CRITICAL
  description               String
  encroachmentAreaSqM       Float?
  affectedAdjacentParcelUprn String?
  detectedAt                DateTime @default(now())
  resolved                  Boolean  @default(false)

  @@map("encroachment_alerts")
}

model SurveySession {
  id                  String   @id @default(uuid())
  surveyCode          String   @unique
  droneModel          String
  flightAltitudeMeters Float
  gsdCmPerPixel       Float    // Ground Sampling Distance
  sensorType          String   // RGB 4K, Multispectral, LiDAR
  totalParcelsDetected Int     @default(0)
  captureDate         DateTime @default(now())
  parcels             Parcel[]

  @@map("survey_sessions")
}
